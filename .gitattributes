# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files
*.html text
*.css text
*.js text
*.mjs text
*.json text
*.md text
*.xml text
*.yml text
*.yaml text

# Declare binary files to prevent Git from attempting to convert line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text
*.mp4 binary
*.webm binary
*.mp3 binary
*.wav binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.tar.gz binary
